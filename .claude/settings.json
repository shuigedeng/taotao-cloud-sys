{
  "permissions": {
    "read": [
      "src/**/*.java",
      "src/**/*.yml",
      "src/**/*.yaml",
      "src/**/*.properties",
      "src/**/*.proto",
      "build.gradle",
      "settings.gradle",
      "gradle/**/*",
      ".opencode/**/*"
    ],
    "write": [
      "src/**/*.java",
      "src/**/*.yml",
      "src/**/*.yaml",
      "src/**/*.properties",
      "src/**/*.proto",
      "build.gradle",
      "settings.gradle",
      "gradle/**/*"
    ],
    "execute": [
      "./gradlew",
      "gradlew.bat",
      "git",
      "docker",
      "docker-compose",
      "kubectl"
    ],
    "network": [
      "localhost:8080",
      "localhost:8848",
      "localhost:3306",
      "localhost:6379",
      "localhost:9090",
      "api.github.com",
      "repo1.maven.org",
      "maven.aliyun.com"
    ]
  },
  "model": {
    "default": "claude-3.5-sonnet-20241022",
    "fallback": "claude-3-opus-20240229",
    "temperature": 0.3,
    "maxTokens": 8192
  },
  "git": {
    "autoCommit": false,
    "requireTests": false,
    "commitMessageTemplate": "{{type}}({{scope}}): {{description}}"
  },
  "java": {
    "buildTool": "gradle",
    "version": 25,
    "buildCommand": "./gradlew build -x test",
    "compileCommand": "./gradlew compileJava",
    "testCommand": "./gradlew test",
    "formatCommand": "./gradlew spotlessApply"
  },
  "lsp": {
    "java": {
      "enabled": true,
      "command": "java",
      "args": [
        "-jar",
        "${workspaceFolder}/../tools/java-language-server.jar"
      ]
    }
  },
  "ddd": {
    "layers": [
      "api",
      "application",
      "assembly",
      "common",
      "domain",
      "facade",
      "infrastructure",
      "interfaces"
    ],
    "package": "com.taotao.cloud.sys",
    "enforceHexagonal": true
  },
  "hooks": {
    "preCommit": [
      "echo 'Running pre-commit checks...'"
    ],
    "postCommit": [],
    "preCommand": []
  }
}
